<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
        x:Class="PalworldServerManager.MainWindow"
        Title="Palworld Server Manager"
        Width="960"
        Height="760">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Spacing="8">
            <TextBlock Text="Palworld Dedicated Server Settings" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Edit documented server and world settings. Leave a field blank to use the server's default. Values are saved as Palworld's OptionSettings tuple." TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="SaveButton" Content="Save Current settings" Click="OnSaveClicked" />
                <Button x:Name="ReloadButton" Content="Reload Current settings" Click="OnReloadClicked" />
                <Button x:Name="ChangeFolderButton" Content="Change config folder..." Click="OnChangeFolderClicked" />
                <Button x:Name="LoadConfigButton" Content="Load config from file..." Click="OnLoadConfigClicked" />
                <Button x:Name="SaveAsButton" Content="Save As..." Click="OnSaveAsClicked" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Load default template..." Click="OnLoadDefaultTemplateClicked" />
                <Button Content="Update default template..." Click="OnUpdateDefaultTemplateClicked" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="Ready" TextWrapping="Wrap" />
            <TextBlock x:Name="UnsavedChangesText"
                       Text="You have unsaved changes."
                       Foreground="Red"
                       FontWeight="Bold"
                       IsVisible="False" />
        </StackPanel>

        <TabControl x:Name="SettingsTabs" Margin="0,12,0,0">
            <TabItem Header="Server">
                <ScrollViewer>
                    <StackPanel Margin="16" Spacing="14">
                        <TextBlock Text="Palworld server manager" FontSize="20" FontWeight="Bold" />
                        <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1" Padding="12">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="Status:" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ServerStatusText" Text="Not detected" VerticalAlignment="Center" />
                                    <Button Content="Refresh status" Click="OnRefreshServerClicked" />
                                    <Button x:Name="StartServerButton" Content="Start" Click="OnStartServerClicked" />
                                    <Button x:Name="StopServerButton" Content="Stop" Click="OnStopServerClicked" />
                                    <Button x:Name="RestartServerButton" Content="Restart" Click="OnRestartServerClicked" />
                                </StackPanel>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="Server executable" VerticalAlignment="Center" />
                                    <TextBox x:Name="ServerExecutableBox" Grid.Column="1" PlaceholderText="PalServer.exe path" />
                                    <Button Grid.Column="2" Content="Browse..." Click="OnBrowseServerClicked" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <TextBlock Text="Launch arguments" VerticalAlignment="Center" />
                                    <TextBox x:Name="ServerArgumentsBox" Grid.Column="1" Text="" PlaceholderText="Optional command-line arguments" />
                                </Grid>
                                <TextBlock Text="RCON console" FontSize="18" FontWeight="Bold" Margin="0,8,0,0" />
                                <TextBlock Text="Send Palworld RCON commands directly. Commands that need arguments can be entered below, for example Broadcast Hello or KickPlayer &lt;SteamID&gt;."
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Save" Click="OnRconSaveClicked" />
                                    <Button Content="Info" Click="OnRconInfoClicked" />
                                    <Button Content="ShowPlayers" Click="OnRconShowPlayersClicked" />
                                </StackPanel>
                                <TextBox x:Name="RconOutputTextBox"
                                         Height="220"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox x:Name="RconCommandBox"
                                             PlaceholderText="Enter RCON command and arguments"
                                             KeyDown="OnRconCommandKeyDown" />
                                    <Button Grid.Column="1" Content="Send" Click="OnRconSendClicked" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Saves">
                <ScrollViewer>
                    <StackPanel Margin="16" Spacing="12">
                        <TextBlock Text="World save management" FontSize="20" FontWeight="Bold" />
                        <TextBlock x:Name="SaveFolderText" TextWrapping="Wrap" />
                        <TextBlock Text="Stop the Palworld server before managing saves. Backups and disabled worlds are stored beside the active save folder." TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Refresh" Click="OnRefreshSavesClicked" />
                            <Button Content="Change save folder..." Click="OnChangeSaveFolderClicked" />
                            <Button Content="Back up active save" Click="OnBackupSaveClicked" />
                            <Button Content="Create new world (disable current)" Click="OnCreateNewWorldClicked" />
                            <Button Content="Disable current save" Click="OnDisableSaveClicked" />
                        </StackPanel>
                        <TextBlock Text="Active world" FontWeight="Bold" />
                        <TextBlock x:Name="ActiveSaveText" Text="No active world save found." TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Backups" FontWeight="Bold" />
                                <ListBox x:Name="BackupList" Height="150" />
                                <Button Content="Restore selected backup" Click="OnRestoreBackupClicked" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Disabled saves" FontWeight="Bold" />
                                <ListBox x:Name="DisabledSaveList" Height="150" />
                                <Button Content="Enable selected save" Click="OnEnableSaveClicked" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
